{
  "name": "terra-watch",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install": "pnpm install",
    "dev:server": "pnpm --filter server start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter server test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
