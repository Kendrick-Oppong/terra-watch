# Python engine configuration
NESTJS_URL=http://localhost:3001
INTERNAL_SECRET=python-engine-shared-secret

# Copernicus Data Space credentials
COPERNICUS_USER=your@email.com
COPERNICUS_PASS=yourpassword

# Processing configuration
SCENE_DOWNLOAD_DIR=/tmp/terrawatch-scenes
CLOUD_COVER_MAX_PCT=20
NDVI_CHANGE_THRESHOLD=-0.2
BSI_CHANGE_THRESHOLD=0.15
MIN_SITE_AREA_M2=500
RISK_ZONE_BUFFER_METRES=2000

LOG_LEVEL=info
