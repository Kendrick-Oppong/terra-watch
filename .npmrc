# pnpm configuration
# Enable strict peer dependencies to catch issues early
strict-peer-dependencies=true

# Use pnpm's built-in deduping algorithm
dedupe-peer-dependents-when-missing=true

# Auto-install missing dependencies
auto-install-peers=true

# Prefer offline when possible
prefer-offline=true

# Enable lockfile validation
lockfile=true

# Enable workspace protocol for local packages
workspace-protocol=prefer
